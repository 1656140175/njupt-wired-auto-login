# ============================================================
#  NJUPT campus network auto login config
#  校园网自动登录配置模板：填写后保存，bat 脚本不用动
#
#  格式：key=value（每行一个），# 开头为注释
#  填完保存后，双击 njupt_autologin.bat 验证即可
# ============================================================

# ---------- 账号（必填，填你的） ----------
# 学号（不带运营商后缀）
user=

# 密码：原样填写即可，含 @ . # = 等特殊字符都无需转义、不用加引号
# （解析规则：每行取第一个 = 之后的内容，所以密码里出现 = 也不影响）
pass=

# 运营商后缀（账号最终格式 = user + suffix）：
#   移动   @cmcc      （南邮移动宽带）
#   电信   @njxy      （南邮电信宽带）
#   校园网 留空即可（无后缀）
suffix=@cmcc

# ---------- 网关（一般不用改） ----------
# 南邮哆点认证网关地址
gateway=http://10.10.244.11:801/eportal/?c=ACSetting&a=Login

# ---------- 常驻检测（watch 模式） ----------
# 检测间隔（秒）：在线时每周期仅 ping 网关确认链路；
# 掉线时每 30 秒快速 ping 等以太网上线，上线且无法访问外网立即尝试登录
interval=900

# 登录失败重试次数（1-10，开机自启默认 3）
attempts=3

# 每次重试间隔（秒）
attempt_delay=6

# ---------- 静默时段 ----------
# 夜间断网窗口：期间链路断则不尝试登录（网络在线则不受影响）
# 格式 HH:MM；想关闭静默就把两个设成相同时间（如 00:00 / 00:00）
quiet_start=00:00
quiet_end=06:00

# ============================================================
#  示例
#  ============================================================
#  电信宽带：     user=学号 / suffix=@njxy
#  校园网内网：   user=学号 / suffix=（留空）
#  完全关闭静默： quiet_start=00:00 / quiet_end=00:00
# ============================================================
