# ============================================================
#  行尾统一：脚本类必须 LF（否则在树莓派上执行报错）
#            Windows 批处理必须 CRLF（否则 ^ 续行会解析失败）
#  Git 会按此规则在检出时自动转换，跨平台 clone 都不会出问题
# ============================================================
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf

*.png       binary
*.jpg       binary
*.zip       binary
